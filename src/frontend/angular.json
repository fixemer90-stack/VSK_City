{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "atlas": {
      "projectType": "application",
      "root": "",
      "sourceRoot": ".",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "main.ts",
            "index": "index.html",
            "tsConfig": "tsconfig.app.json",
            "assets": [{"glob":"**/*","input":"public"}],
            "styles": [
              "styles.css"
            ],
            "outputPath": "dist/atlas",
            "budgets": [
              {
                "type": "initial",
                "maximumWarning": "1.3MB",
                "maximumError": "2MB"
              }
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "atlas:build:development",
            "proxyConfig": "proxy.conf.json"
          }
        }
      }
    }
  }
}